# Copy environment values into the production runner/environment configuration.
# Do not commit populated secrets. K-Trader v1 does not require exchange API credentials.

KTRADER_ROOT=/opt/k-trader
KTRADER_PROVIDERS=binance_usdm,bybit_linear
KTRADER_QUOTE_ASSET=USDT
KTRADER_PRICE_LIMIT_ENABLED=true
KTRADER_MAX_PRICE=3
KTRADER_MAX_CANDIDATES=50
KTRADER_ANALYSIS_LIMIT=20
KTRADER_SCAN_INTERVAL_SECONDS=60
KTRADER_BOOTSTRAP_CONCURRENCY=2

KTRADER_RESEARCH_CAPTURE_ENABLED=true
KTRADER_RESEARCH_CAPTURE_INTERVAL_SECONDS=300
KTRADER_BACKUP_ENABLED=true
KTRADER_BACKUP_INTERVAL_SECONDS=21600
KTRADER_BACKUP_RETENTION=7
KTRADER_DISK_MIN_FREE_BYTES=2147483648
KTRADER_DISK_MIN_FREE_PERCENT=5
KTRADER_HEALTH_MAX_SCAN_AGE_SECONDS=180

# Required only for public Custom GPT Action deployment.
# In GitHub Actions production use the Environment secret KTRADER_ACTION_API_KEY.
KTRADER_ACTION_API_KEY=

# Optional. Enables the Caddy HTTPS profile when non-empty.
# DNS must resolve to the production host before deployment acceptance can pass.
KTRADER_DOMAIN=
