# Copy environment values into the production runner/environment configuration.
# Do not commit secrets. K-Trader v1 does not require exchange API credentials.

KTRADER_ROOT=/opt/k-trader
KTRADER_PROVIDERS=binance_usdm,bybit_linear
KTRADER_QUOTE_ASSET=USDT
KTRADER_PRICE_LIMIT_ENABLED=true
KTRADER_MAX_PRICE=3
KTRADER_MAX_CANDIDATES=50
KTRADER_ANALYSIS_LIMIT=20
KTRADER_SCAN_INTERVAL_SECONDS=60
KTRADER_BOOTSTRAP_CONCURRENCY=2

# Optional. Required only when deploying the Caddy HTTPS profile.
KTRADER_DOMAIN=
